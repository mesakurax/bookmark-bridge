{
  "manifest_version": 3,
  "name": "Bookmark Bridge",
  "version": "2.2.1",
  "description": "通过浏览器原生 API 在 Chrome 与 Edge 之间同步收藏夹",
  "key": "",
  "permissions": [
    "bookmarks",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
